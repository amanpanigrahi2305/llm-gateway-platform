# Copy to .env (git ignores it).
# Provider keys are only needed for real providers. The gateway reads the
# variable named in each provider's api_key_env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Rate-limit and budget counters (`make dev-up` starts this Redis on port 6380)
GATEWAY_REDIS_URL=redis://localhost:6380/0
